<Project>
  <!--
    Fix: Duplicate assembly attribute generation (CS0579) across the repo.

    Some builds end up producing assembly attributes from multiple sources
    (e.g., generated AssemblyInfo + other generated fragments), resulting in
    duplicate attributes like AssemblyCompany, AssemblyVersion, and
    TargetFrameworkAttribute.

    Disabling generation here centralizes behavior across all projects.
  -->
  <PropertyGroup>
    <!-- Prevent generation of obj/**/Project.AssemblyInfo.cs -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

    <!-- Prevent generation of obj/**/.NETCoreApp,Version=...AssemblyAttributes.cs -->
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>
</Project>
